# ─── Required API keys ──────────────────────────────────────────────────────
# Your Poe API key (from https://poe.com/api_key)
POE_API_KEY=

# Your Google AI / Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ─── Authentication (at least one recommended for production) ───────────────

# Option A: Supabase JWT verification
# The JWT secret from your Supabase project (Settings → API → JWT Secret)
# When set, all requests must include a valid Supabase JWT as Bearer token.
SUPABASE_JWT_SECRET=

# Option B: Static shared secret
# A simple shared token. Requests can authenticate by sending this as the
# Bearer token instead of (or in addition to) a Supabase JWT.
PROXY_SECRET=

# ─── Optional overrides ────────────────────────────────────────────────────
# Override the Poe API base URL (default: https://api.poe.com)
# POE_API_BASE=https://api.poe.com

# Comma-separated allowed CORS origins. Default: * (allow all).
# Example: https://barrix-ide.vercel.app,capacitor://localhost,http://localhost
# ALLOWED_ORIGINS=*
